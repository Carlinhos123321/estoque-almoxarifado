# IMA Stock - Environment variables example
# Copy this file to .env and fill in real values

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=0

# Database
# Railway injects DATABASE_URL in production.
DATABASE_URL=postgresql://user:password@host:5432/railway
LOG_DATABASE_URI=0

# Schema management
# Keep disabled in production; use `flask db upgrade`.
AUTO_CREATE_SCHEMA=0

# Initial admin defaults used by seed/custom setup scripts
ADMIN_EMAIL=admin@imastock.com
ADMIN_PASSWORD=change-this-before-deploy
ADMIN_NAME=Administrador

# Password recovery
PASSWORD_RESET_TOKEN_MINUTES=30

# Company defaults
COMPANY_NAME=IMA Stock
COMPANY_CNPJ=00.000.000/0001-00
