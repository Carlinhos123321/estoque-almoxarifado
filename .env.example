# MovStok ERP - Environment variables example
# Copy this file to .env and fill in real values

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# Railway already injects DATABASE_URL in production.
DATABASE_URL=postgresql://user:password@host:5432/movstok

# Initial admin (created automatically on first boot if no users exist)
ADMIN_EMAIL=admin@movstok.com
ADMIN_PASSWORD=change-this-before-deploy
ADMIN_NAME=Administrador

# Password recovery
PASSWORD_RESET_TOKEN_MINUTES=30

# Company defaults
COMPANY_NAME=MovStok Logística Ltda
COMPANY_CNPJ=00.000.000/0001-00
